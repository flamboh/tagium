FROM registry.fly.io/tagium-cobalt@sha256:da74e9ae6221fd5b0dbdd24a0c3893ec140c4e8a067dd8cec59f0569e5883425

COPY --chown=node:node cobalt-machine-proxy.mjs /app/cobalt-machine-proxy.mjs
COPY --chown=node:node cobalt-soundcloud.mjs /app/src/processing/services/soundcloud.js
COPY --chown=node:node cobalt-soundcloud-helpers.mjs /app/cobalt-soundcloud-helpers.mjs
COPY --chown=node:node cobalt-patch-ffmpeg.mjs /tmp/cobalt-patch-ffmpeg.mjs
RUN node /tmp/cobalt-patch-ffmpeg.mjs /app/src/stream/ffmpeg.js && rm /tmp/cobalt-patch-ffmpeg.mjs

CMD ["node", "/app/cobalt-machine-proxy.mjs"]
