{
  "name": "tagium-youtube-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:local": "wxt build --mode development",
    "build:local:firefox": "wxt build -b firefox --mode development",
    "build:firefox": "wxt build -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "youtubei.js": "17.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wxt": "0.21.4"
  }
}
